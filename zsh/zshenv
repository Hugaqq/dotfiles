# zshenv — 所有 zsh 都会读取（脚本、编辑器、工具调起的非交互 shell），保持轻量。
# 只放环境变量；登录配置在 zprofile，交互配置在 zshrc。

skip_global_compinit=1          # Debian/Ubuntu：不让 /etc/zsh/zshrc 提前跑一遍 compinit

typeset -U path PATH            # PATH 自动去重，嵌套 shell 不会越叠越长
path=(
  $HOME/.local/bin
  $HOME/.cargo/bin
  $HOME/.npm-global/bin
  $HOME/go/bin
  /opt/homebrew/opt/rustup/bin
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /home/linuxbrew/.linuxbrew/bin
  $path
)

export EDITOR=vim
export VISUAL=vim
export PAGER=less
export LESS='-R -F -X'
export BAT_THEME=ansi           # bat 跟随终端自身配色

# 这台机器私有的 PATH / 环境变量（不进 git）
() { [[ -r $1 ]] && source $1 } ${${(%):-%N}:A:h}/local.zshenv

path=($^path(N-/))              # 去掉这台机器上不存在的目录
export PATH
